# 복사해서 사용: cp .env.example .env   (.env 는 gitignore 대상, 실제 키는 절대 커밋하지 않음)

# 식품안전나라 OpenAPI 인증키 — COOKRCP01(조리식품 레시피 DB)
FOODSAFETY_API_KEY=

# 공공데이터포털 일반 인증키(Decoding) — 식품영양성분DB(FoodNtrCpntDbInfo03), 중앙부처·지자체 복지서비스
# API마다 공공데이터포털에서 활용신청 승인이 따로 필요하다.
DATA_GO_KR_SERVICE_KEY=

# src/frontend/tool/fetch_welfare_data.py 는 같은 공공데이터포털 키를 이 이름으로 읽는다.
# 데이터 갱신(agetech_data.refresh)은 DATA_GO_KR_SERVICE_KEY 가 없으면 이 값을 쓴다.
WELFARE_API_KEY=

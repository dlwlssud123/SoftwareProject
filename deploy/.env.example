API_IMAGE=valueflow-backend:first
API_PORT=18081
POSTGRES_DB=valueflow
POSTGRES_USER=valueflow
POSTGRES_PASSWORD=
DATABASE_URL=
KAKAO_APP_ID=
CORS_ORIGINS=[]
SESSION_TTL_SECONDS=604800
ADMIN_SESSION_TTL_SECONDS=3600
NVIDIA_AI_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TIMEOUT_SECONDS=25
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=100

# KURE worker and the active DB index must use the documented model/revision.
WELFARE_RAG_ENABLED=false
RAG_EMBEDDING_URL=
RAG_EMBEDDING_TOKEN=
RAG_EMBEDDING_TIMEOUT_SECONDS=5
EMBEDDING_IMAGE=valueflow-embedding:local
HF_HUB_OFFLINE=0
